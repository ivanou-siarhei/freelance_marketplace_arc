# Copy to .env and fill in. Never commit .env.

# ---- API server (server/) ----
DATABASE_URL=postgres://user:password@host:5432/arcwork
API_PORT=8787
# Exact hosts or parent rules like *.example.com. The hosts where the web app is served. Server side only.
SIWE_ALLOWED_DOMAINS=app.example.com
# Exact browser origins that may call the API from another site (the web app's address).
CORS_ALLOWED_ORIGINS=https://app.example.com
SESSION_TTL_HOURS=24
ACCEPT_FUNDING_WINDOW_HOURS=48
# Deployed escrow contract and the block it was deployed in (public values).
VITE_ESCROW_ADDRESS=0x0e92db9a92b8bc43240e72c088defbb3e03fba78
VITE_ESCROW_DEPLOY_BLOCK=
# Optional. For a brand-new database, "latest" skips scanning old blocks.
INDEXER_START_BLOCK=latest
# Optional but recommended for a hosted API: your own Arc Testnet RPC URL (may contain a key).
RPC_URL_Arc_Testnet=

# ---- Web app (build time, public) ----
# Address of the deployed API, for example https://arcwork-api.example.com
VITE_API_BASE_URL=
